{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {"source": "/conserto-notebook", "destination": "/", "permanent": true},
    {"source": "/conserto-notebook/:path*", "destination": "/:path*", "permanent": true}
  ]
}
